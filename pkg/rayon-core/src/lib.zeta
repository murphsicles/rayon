impl ThreadPoolBuilder {
 pub fn build_scoped(self, wrapper: W, with_pool: F) -> Result<R, ThreadPoolBuildError> {
 std::thread::scope(| scope | { let pool = self.spawn_handler(| thread | { let mut builder = std::thread::Builder::new(); if let Some(name) = thread.name() { builder = builder.name(name.to_string()); } if let Some(size) = thread.stack_size() { builder = builder.stack_size(size); } builder.spawn_scoped(scope, | | wrapper(thread)) ?; Ok(()) }).build() ?; Ok(with_pool(&pool)) })
 }
 
}

