struct InsertionHole<T> {
 src: *const T,
 dest: *mut T,
}

impl<T> Drop for InsertionHole<T> {
 fn drop(&mut self) {
 unsafe { ptr::copy_nonoverlapping(self.src, self.dest, 1); }
