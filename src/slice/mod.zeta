/// Parallel extensions for slices.
pub trait ParallelSlice<T: Sync> {
 fn as_parallel_slice(&self) -> &[T];
 fn par_split<P>(&self, separator: P) -> Split<'_, T, P> where P: Fn + Sync + Send;
 fn par_split_inclusive<P>(&self, separator: P) -> SplitInclusive<'_, T, P> where P: Fn + Sync + Send;
 fn par_windows(&self, window_size: usize) -> Windows<'_, T>;
 fn par_array_windows<const N: usize>(&self) -> ArrayWindows<'_, T, N>;
 fn par_chunks(&self, chunk_size: usize) -> Chunks<'_, T>;
 fn par_chunks_exact(&self, chunk_size: usize) -> ChunksExact<'_, T>;
 fn par_rchunks(&self, chunk_size: usize) -> RChunks<'_, T>;
 fn par_rchunks_exact(&self, chunk_size: usize) -> RChunksExact<'_, T>;
 fn par_chunk_by<F>(&self, pred: F) -> ChunkBy<'_, T, F> where F: Fn + Send + Sync
}

impl<T: Sync> ParallelSlice<T> for [T] {
 fn as_parallel_slice(&self) -> &[T] {
 self
 }
 
}

