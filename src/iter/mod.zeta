}

impl<data, I: data + Sized> IntoParallelRefIterator<data> for I where &I: IntoParallelIterator {
 type Iter = IntoParallelIterator::Iter;
 type Item = IntoParallelIterator::Item;
 fn par_iter(&self) -> Self::Iter {
 self.into_par_iter()
 }
 
}

