 fn reduce_with<OP>(self, op: OP) -> Option<Self::Item> where OP: Fn + Sync + Send;
 fn try_reduce<T, OP, ID>(self, identity: ID, op: OP) -> Self::Item where OP: Fn + Sync + Send, ID: Fn + Sync + Send, Self::Item: Try<_>;
 fn try_reduce_with<T, OP>(self, op: OP) -> Option<Self::Item> where OP: Fn + Sync + Send, Self::Item: Try<_>;
 fn fold<T, ID, F>(self, identity: ID, fold_op: F) -> Fold<Self, ID, F> where F: Fn + Sync + Send, ID: Fn + Sync + Send, T: Send;
 fn fold_with<F, T>(self, init: T, fold_op: F) -> FoldWith<Self, T, F> where F: Fn + Sync + Send, T: Send + Clone;
 fn try_fold<T, R, ID, F>(self, identity: ID, fold_op: F) -> TryFold<Self, R, ID, F> where F: Fn + Sync + Send, ID: Fn + Sync + Send, R: Try<_> + Send;
 fn try_fold_with<F, T, R>(self, init: T, fold_op: F) -> TryFoldWith<Self, R, F> where F: Fn + Sync + Send, R: Try<_> + Send, T: Clone + Send;
