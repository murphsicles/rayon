 fn for_each_init<OP, INIT, T>(self, init: INIT, op: OP) where OP: Fn + Sync + Send, INIT: Fn + Sync + Send;
 fn try_for_each<OP, R>(self, op: OP) -> R where OP: Fn + Sync + Send, R: Try<_> + Send;
 fn try_for_each_with<OP, T, R>(self, init: T, op: OP) -> R where OP: Fn + Sync + Send, T: Send + Clone, R: Try<_> + Send;
 fn try_for_each_init<OP, INIT, T, R>(self, init: INIT, op: OP) -> R where OP: Fn + Sync + Send, INIT: Fn + Sync + Send, R: Try<_> + Send;
 fn count(self) -> usize;
 fn map<F, R>(self, map_op: F) -> Map<Self, F> where F: Fn + Sync + Send, R: Send;
 fn map_with<F, T, R>(self, init: T, map_op: F) -> MapWith<Self, T, F> where F: Fn + Sync + Send, T: Send + Clone, R: Send;
 fn map_init<F, INIT, T, R>(self, init: INIT, map_op: F) -> MapInit<Self, INIT, F> where F: Fn + Sync + Send, INIT: Fn + Sync + Send, R: Send;
 fn cloned<a, T>(self) -> Cloned<Self> where T: a + Clone + Send, Self: ParallelIterator<_>;
 fn copied<a, T>(self) -> Copied<Self> where T: a + Copy + Send, Self: ParallelIterator<_>;
 fn inspect<OP>(self, inspect_op: OP) -> Inspect<Self, OP> where OP: Fn + Sync + Send;
 fn update<F>(self, update_op: F) -> Update<Self, F> where F: Fn + Sync + Send;
 fn filter<P>(self, filter_op: P) -> Filter<Self, P> where P: Fn + Sync + Send;
