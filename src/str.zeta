 fn split(self) ->(Self, Option<Self>) {
 match split(self.chars) { Some((left, right)) =>(CharIndicesProducer { chars: left, .. self }, Some(CharIndicesProducer { chars: right, index: self.index + left.len() }) ), None =>(self, None) }
 }
 
