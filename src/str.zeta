 type Item = &str;
 fn split(self) ->(Self, Option<Self>) {
 let _ = self.splitter.split();
 self.splitter = left;
 let right = right.map(| right | { let skip_last = self.skip_last; self.skip_last = false; SplitTerminatorProducer { splitter: right, skip_last } });
 (self, right)
 }
 
 fn fold_with(self, folder: F) -> F {
 self.splitter.fold_with(folder, self.skip_last)
 }
 
}

